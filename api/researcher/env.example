# Server-only researcher API environment (Vercel project + local .env).
# Copy values into a gitignored .env or Vercel Environment Variables.
# Never copy these names or values into researcher/config.js or other browser files.
# Do not prefix secrets with browser-exposed public prefixes.

# ---------------------------------------------------------------------------
# PUBLIC / CLIENT-SAFE (browser-delivered researcher/config.js only)
# ---------------------------------------------------------------------------
# RESEARCHER_ENDPOINT stays empty in the committed file (fail-closed).
# When the same-origin API is intentionally connected, operators set:
#   RESEARCHER_ENDPOINT: '/api/researcher'
# That path is not a secret. It still returns no research data without a session.

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS AND FLAGS
# ---------------------------------------------------------------------------
RESEARCHER_API_ENABLED=false
EXPORTS_ENABLED=false
DELETIONS_ENABLED=false

# Temporary Preview-only database identity check. Never enable in Production.
# RESEARCHER_DB_DIAGNOSTIC_ENABLED=false

# Required before the API may authenticate or serve research data.
# SESSION_STORE=memory and RATE_LIMIT_STORE=memory are ignored.
# DATABASE_URL must be the least-privilege researcher_api role.
# Prefer the Supabase transaction pooler URI for Vercel Node functions.
# Never use the service-role key, anon key, or owner credentials here.
# DATABASE_URL=
# SESSION_SECRET=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_AUDIENCE=
# OIDC_REQUIRED_ACR=
# OIDC_REQUIRED_AMR=
# OIDC_LOGOUT_URL=
# SESSION_STORE=database
# RATE_LIMIT_STORE=database
# ARCHIVE_PATH=/researcher/

# Vercel-aware client IP (off by default). Do not set TRUSTED_PROXY=true
# merely because a proxy exists. For Vercel, after the institution accepts
# Vercel as the TLS terminator:
# TRUSTED_PROXY=vercel
# That reads only x-vercel-forwarded-for. Arbitrary X-Forwarded-For is ignored.
TRUSTED_PROXY=false
# TRUSTED_CLIENT_IP_HEADER=

SESSION_MINUTES=20
MAX_PAGE_SIZE=50
MAX_EXPORT_ROWS=2000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=10

# Researcher-access telemetry. Off until a DPO decision. Never log survey answers.
AUDIT_STORE_RESEARCHER_IP=false

# Same-origin by default. Do not set "*". Leave empty for production.
# ALLOWED_ORIGIN=
