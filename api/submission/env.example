# Server-only submission API environment (Vercel project + local .env).
# Copy values into a gitignored .env or Vercel Environment Variables.
# Never copy these names or values into config.js or other browser files.
# Do not enable collection from this file alone — browser COLLECTION_ENABLED
# and SUBMISSION_ENDPOINT must also be set deliberately after approvals.

# Dual kill switch (server half). Fail-closed unless explicitly true.
SUBMISSION_API_ENABLED=false

# Least-privilege submission_inserter role only. Never service-role,
# anon, or researcher_api. Prefer the Supabase transaction pooler URI.
# SUBMISSION_DATABASE_URL=
# Server-only PEM CA for verified TLS (rejectUnauthorized stays true).
# May reuse DATABASE_CA_CERT when the same project CA applies.
# SUBMISSION_DATABASE_CA_CERT=
# SUBMISSION_RATE_LIMIT_STORE=database

# Exact HTTPS origin allowlist. Never "*". Leave empty for same-origin
# Host-derived checks on a single Vercel deployment.
# SUBMISSION_ALLOWED_ORIGIN=

# Optional limits (defaults are fail-closed / conservative).
# SUBMISSION_MAX_BODY_BYTES=96000
# SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
# SUBMISSION_RATE_LIMIT_MAX=12

# Shared with researcher when TRUSTED_PROXY=vercel (x-vercel-forwarded-for only).
TRUSTED_PROXY=false
